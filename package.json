{
  "name": "eldercare-360-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:client": "vite build",
    "build": "pnpm --recursive run build",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:all": "jest",
    "security:all": "jest test/security",
    "a11y:all": "jest test/accessibility",
    "verify:ps": "jest",
    "quality": "jest",
    "lint": "eslint \"{apps,packages,scripts}/**/*.ts\"",
    "seed": "ts-node -r tsconfig-paths/register scripts/seed.ts",
    "start:api": "ts-node -r tsconfig-paths/register apps/api/src/main.ts",
    "start:worker": "ts-node -r tsconfig-paths/register apps/worker/src/main.ts",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "verify:routes": "ts-node scripts/verify-route-actions.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.32.0",
    "clsx": "^2.1.1",
    "firebase": "^11.0.2",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.0",
    "tailwind-merge": "^2.3.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "fast-check": "^3.18.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.38",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.3",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "vite-plugin-pwa": "^0.20.0"
  }
}
